{
  "name": "invoice-review-desk",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "RUNS", "class_name": "InvoiceWorkspace" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InvoiceWorkspace"] }],
  "secrets": { "required": ["GEMINI_API_KEY", "DEMO_ACCESS_CODE"] }
}
