{
  "name": "invoice-review-desk",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "node --env-file-if-exists=.env.local src/local.ts",
    "check": "tsc --noEmit -p tsconfig.json && wrangler types worker-configuration.d.ts --include-env false && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --test tests/*.test.ts",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "dependencies": {
    "@hyzyla/pdfium": "^3.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fast-png": "^8.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  }
}
